<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <ProjectGuid>{1286F032-5E38-4E0D-A240-9E36AE2FDC4C}</ProjectGuid>
    <ProjectName>GunBrosRe</ProjectName>
    <RepoRoot>$(MSBuildProjectDirectory)\</RepoRoot>
    <Configuration Condition="'$(Configuration)'==''">Debug</Configuration>
    <Platform Condition="'$(Platform)'==''">x64</Platform>
    <VCProjectVersion>18.0</VCProjectVersion>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <!-- This single project file produces all three executables. Building the
         default Game product also builds the companions; see BuildCompanions. -->
    <GbProduct Condition="'$(GbProduct)'==''">Game</GbProduct>
  </PropertyGroup>
  <ItemGroup Label="ProjectConfigurations">
    <!-- x64 only: the bundled SDL3 runtime is x64. -->
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Product">
    <!-- Executable name per product. An unknown GbProduct leaves this empty and
         ValidateProduct stops the build instead of writing a nameless target. -->
    <GbTargetName Condition="'$(GbProduct)'=='Game'">GunBrosRe</GbTargetName>
    <GbTargetName Condition="'$(GbProduct)'=='Viewer'">GunBrosViewer</GbTargetName>
    <GbTargetName Condition="'$(GbProduct)'=='Tests'">GunBrosTests</GbTargetName>
    <!-- Tests own their sources in both configurations. Capture also remains
         available to Debug game/viewer runs for existing visual checks. -->
    <GbCaptureEnabled>0</GbCaptureEnabled>
    <GbCaptureEnabled Condition="'$(Configuration)'=='Debug' or '$(GbProduct)'=='Tests'">1</GbCaptureEnabled>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <LinkIncremental>false</LinkIncremental>
    <TargetName>$(GbTargetName)</TargetName>
    <OutDir>$(RepoRoot)bin\$(Configuration)\</OutDir>
    <!-- One intermediate directory per product; sharing one would trip MSB8028. -->
    <IntDir>$(RepoRoot)obj\$(Platform)\$(Configuration)\$(GbTargetName)\</IntDir>
    <LocalDebuggerWorkingDirectory>$(OutDir)</LocalDebuggerWorkingDirectory>
    <!-- F5 runs the game. Set GbDebugTarget to GunBrosViewer or GunBrosTests in
         the project properties to debug a companion; that value lands in the
         ignored .vcxproj.user file and never changes what gets built. -->
    <GbDebugTarget Condition="'$(GbDebugTarget)'==''">GunBrosRe</GbDebugTarget>
    <LocalDebuggerCommand>$(OutDir)$(GbDebugTarget).exe</LocalDebuggerCommand>
    <LocalDebuggerCommandArguments />
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
    <FeatureDefinitions>GB_ENABLE_CAPTURE=$(GbCaptureEnabled)</FeatureDefinitions>
    <FeatureDefinitions Condition="'$(Configuration)'=='Debug'">_DEBUG;$(FeatureDefinitions)</FeatureDefinitions>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(RepoRoot)src;$(RepoRoot)src\third_party\zlib;$(RepoRoot)src\third_party\SDL3\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalIncludeDirectories Condition="'$(GbProduct)'=='Tests'">$(RepoRoot);$(RepoRoot)tests;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>$(FeatureDefinitions);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <Optimization Condition="'$(Configuration)'=='Debug'">Disabled</Optimization>
      <Optimization Condition="'$(Configuration)'=='Release'">MaxSpeed</Optimization>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebugDLL</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
    <Link>
      <!-- The game owns a native window; both companions are console tools. -->
      <SubSystem Condition="'$(GbProduct)'=='Game'">Windows</SubSystem>
      <SubSystem Condition="'$(GbProduct)'!='Game'">Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <ProgramDatabaseFile>$(IntDir)$(TargetName).pdb</ProgramDatabaseFile>
      <AdditionalLibraryDirectories>$(RepoRoot)src\third_party\SDL3\lib\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>SDL3.lib;opengl32.lib;mfplat.lib;mfreadwrite.lib;mfuuid.lib;ole32.lib;gdiplus.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <!-- Compile the required source packages directly into this executable. -->
  <ItemGroup>
    <ClCompile Include="$(RepoRoot)src\engine\**\*.cpp" />
    <ClInclude Include="$(RepoRoot)src\engine\**\*.h" />
    <ClCompile Include="$(RepoRoot)src\third_party\zlib\*.c">
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;_CRT_NONSTDC_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ClCompile Include="$(RepoRoot)src\gun_bros_re\**\*.cpp" Exclude="$(RepoRoot)src\gun_bros_re\main.cpp" />
    <ClInclude Include="$(RepoRoot)src\gun_bros_re\**\*.h" />
  </ItemGroup>
  <!-- The viewer executable hosts every resource page. -->
  <ItemGroup Condition="'$(GbProduct)'=='Viewer'">
    <ClCompile Include="$(RepoRoot)src\gun_bros_viewer\**\*.cpp" Exclude="$(RepoRoot)src\gun_bros_viewer\main.cpp" />
    <ClInclude Include="$(RepoRoot)src\gun_bros_viewer\**\*.h" />
  </ItemGroup>
  <!-- Test capture cases reuse the same viewer scene hosts. -->
  <ItemGroup Condition="'$(GbProduct)'=='Tests'">
    <ClCompile Include="$(RepoRoot)src\gun_bros_viewer\scenes\*.cpp" />
    <ClCompile Include="$(RepoRoot)src\gun_bros_viewer\ViewerSettings.cpp" />
    <ClCompile Include="$(RepoRoot)src\gun_bros_viewer\ViewerControls.cpp" />
    <ClInclude Include="$(RepoRoot)src\gun_bros_viewer\ViewerSettings.h" />
    <ClInclude Include="$(RepoRoot)src\gun_bros_viewer\scenes\*.h" />
  </ItemGroup>
  <ItemGroup Condition="'$(GbProduct)'=='Tests'">
    <ClCompile Include="$(RepoRoot)tests\**\*.cpp" Exclude="$(RepoRoot)tests\main.cpp;$(RepoRoot)tests\out\**" />
    <ClInclude Include="$(RepoRoot)tests\**\*.h" Exclude="$(RepoRoot)tests\out\**" />
  </ItemGroup>
  <!-- Exactly one entry point per product. -->
  <ItemGroup>
    <ClCompile Condition="'$(GbProduct)'=='Game'" Include="$(RepoRoot)src\gun_bros_re\main.cpp" />
    <ClCompile Condition="'$(GbProduct)'=='Viewer'" Include="$(RepoRoot)src\gun_bros_viewer\main.cpp" />
    <ClCompile Condition="'$(GbProduct)'=='Tests'" Include="$(RepoRoot)tests\main.cpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="ValidateProduct" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(GbTargetName)'==''" Text="Unknown GbProduct '$(GbProduct)'. Use Game, Viewer or Tests." />
  </Target>
  <Target Name="StageRuntime" AfterTargets="Build" Condition="'$(SkipRuntimeStaging)'!='true'">
    <ItemGroup>
      <RuntimeBig Include="$(RepoRoot)big\**\*" />
      <RuntimeAssets Include="$(RepoRoot)assets\**\*" />
    </ItemGroup>
    <Error Condition="'@(RuntimeBig)'=='' or '@(RuntimeAssets)'==''" Text="Missing runtime inputs. Restore big/ and assets/ before building." />
    <Copy SourceFiles="@(RuntimeBig)" DestinationFiles="@(RuntimeBig->'$(OutDir)big\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RuntimeAssets)" DestinationFiles="@(RuntimeAssets->'$(OutDir)assets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <!-- SDL3 is a DLL; it has to sit next to the .exe to run. -->
    <Copy SourceFiles="$(RepoRoot)src\third_party\SDL3\lib\x64\SDL3.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <!-- Building the game also builds the viewer and tests in both configurations. The
       recursive passes carry SkipCompanions so they do not recurse again, and
       SkipRuntimeStaging because the game pass already filled the same OutDir. -->
  <Target Name="BuildCompanions" AfterTargets="StageRuntime" Condition="'$(GbProduct)'=='Game' and '$(SkipCompanions)'!='true'">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build" Properties="GbProduct=Viewer;Configuration=$(Configuration);Platform=$(Platform);SkipCompanions=true;SkipRuntimeStaging=true" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build" Properties="GbProduct=Tests;Configuration=$(Configuration);Platform=$(Platform);SkipCompanions=true;SkipRuntimeStaging=true" />
  </Target>
  <!-- Debug runs the checks both former product projects owned: the game's
       progress case, the viewer's big-version and viewer-controls cases, and
       the six-entry viewer smoke script. -->
  <Target Name="RunCorrespondingDebugTest" AfterTargets="BuildCompanions" Condition="'$(GbProduct)'=='Game' and '$(Configuration)'=='Debug' and '$(SkipAutoTests)'!='true'">
    <Exec Command="pwsh -NoProfile -File &quot;$(RepoRoot)tests\run.ps1&quot; -Case progress,big-version,viewer-controls -NoBuild" />
    <Exec Command="pwsh -NoProfile -File &quot;$(RepoRoot)tests\viewer-smoke.ps1&quot;" />
  </Target>
</Project>
