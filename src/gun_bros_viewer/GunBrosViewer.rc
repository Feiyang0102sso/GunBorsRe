// Executable resources for GunBrosViewer.exe: the window/Explorer icon and the
// version block Explorer's property sheet reads.
#include <winres.h>
#include "ZProductVersion.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

// The path is relative to this script; assets/icon is committed for this reason.
GB_ICON_ID ICON "../../assets/icon/GBViewer.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION GB_VERSION_NUMBER
PRODUCTVERSION GB_VERSION_NUMBER
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 040904b0: US English, Unicode code page. Matches the VarFileInfo pair.
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      GB_COMPANY_NAME
            VALUE "FileDescription",  "GunBrosViewer"
            VALUE "FileVersion",      GB_VERSION_TEXT
            VALUE "InternalName",     "GunBrosViewer"
            VALUE "LegalCopyright",   GB_COPYRIGHT
            VALUE "OriginalFilename", "GunBrosViewer.exe"
            VALUE "ProductName",      GB_PRODUCT_NAME
            VALUE "ProductVersion",   GB_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
